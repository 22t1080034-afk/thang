@{
    Layout = null;
}

<div class="modal-dialog">
    <div class="modal-content">
        <form action="~/Order/Finish/@ViewBag.OrderID" method="post">
    @Html.AntiForgeryToken()
            <div class="modal-header bg-success text-white">
                <h5 class="modal-title">Xác nhận hoàn tất đơn hàng</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <p class="text-success">
                    <i class="bi bi-check-circle-fill"></i> Đơn hàng <strong>@ViewBag.OrderID</strong> đã được giao thành công và thanh toán đầy đủ?
                </p>
            </div>
            <div class="modal-footer">
                <button type="submit" class="btn btn-success">Xác nhận hoàn tất</button>
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Hủy bỏ</button>
            </div>
        </form>
    </div>
</div>