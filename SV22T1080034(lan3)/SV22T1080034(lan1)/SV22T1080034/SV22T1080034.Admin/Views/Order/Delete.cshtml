@{
    Layout = null;
}

<div class="modal-dialog modal-dialog-centered">
    <div class="modal-content shadow">
        <form asp-action="Delete" asp-controller="Order" method="post">
            @Html.AntiForgeryToken()
            <input type="hidden" name="id" value="@ViewBag.OrderID" />

            <div class="modal-header bg-gradient bg-danger text-white">
                <h5 class="modal-title">
                    <i class="bi bi-trash3 me-2"></i>Xóa đơn hàng #@ViewBag.OrderID
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>

            <div class="modal-body text-center py-4">
                <div class="mb-3">
                    <i class="bi bi-exclamation-triangle-fill text-danger display-4"></i>
                </div>
                <h5 class="text-danger">Xác nhận xóa đơn hàng</h5>
                <p class="mb-0">
                    Bạn có chắc chắn muốn <strong>xóa vĩnh viễn</strong> đơn hàng này?
                </p>

                <hr>

                <div class="alert alert-warning mb-0">
                    <small>Không thể khôi phục!</small>
                </div>
            </div>

            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">
                    Hủy
                </button>
                <button type="submit" class="btn btn-danger">
                    Xóa
                </button>
            </div>
        </form>
    </div>
</div>