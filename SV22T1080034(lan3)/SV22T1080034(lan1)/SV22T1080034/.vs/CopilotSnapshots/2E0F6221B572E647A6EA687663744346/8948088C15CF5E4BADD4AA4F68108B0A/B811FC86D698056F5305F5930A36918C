@{
    ViewBag.Title = "Lập đơn hàng";
}

<div class="row">
    <div class="col-4">
        <div class="card card-outline card-primary h-100">
            <div class="card-header">
                <h5 class="mb-0">
                    <i class="bi bi-search"></i>
                    Lựa chọn hàng cần bán
                </h5>
            </div>

            <div class="card-body">
                <form id="frmSearch" method="get" class="mb-3">
                    <div class="input-group">
                        <input class="form-control"
                               name="searchValue"
                               placeholder="Nhập tên mặt hàng cần tìm" autofocus />
                        <button class="btn btn-primary" type="submit">
                            <i class="bi bi-search"></i>
                        </button>
                    </div>
                </form>

                <div id="searchResult">
                    @for (int i = 1; i <= 3; i++)
                    {
                        // Đã gắn class="frmAddToCart" để gọi AJAX
                        <form class="frmAddToCart" method="post" class="border rounded p-2 mb-2">
                            <input type="hidden" name="productId" value="@i" />

                            <strong>Macbook Pro 15" M2 2023</strong>

                            <div class="row mt-2">
                                <div class="col-4">
                                    <img src="~/images/products/demo.png"
                                         class="img-fluid border" style="max-height:100px" />
                                </div>
                                <div class="col-8">
                                    <div class="row g-2">
                                        <div class="col-7">
                                            <label class="form-label mb-0">Giá</label>
                                            <input name="salePrice" class="form-control form-control-sm money-input"
                                                   value="45000000" />
                                        </div>
                                        <div class="col-5">
                                            <label class="form-label mb-0">SL</label>
                                            <input type="number" name="quantity"
                                                   min="1"
                                                   value="1"
                                                   class="form-control form-control-sm" />
                                        </div>
                                    </div>

                                    <button type="submit" class="btn btn-sm btn-primary mt-2 w-100">
                                        <i class="bi bi-cart-plus"></i>
                                        Thêm vào giỏ
                                    </button>
                                </div>
                            </div>
                        </form>
                    }
                </div>
            </div>

            <div class="card-footer">
                <ul class="pagination justify-content-between mb-0">
                    <li class="page-item">
                        <a class="page-link" href="javascript:;" onclick="doSearch(1)">
                            <i class="bi bi-chevron-left"></i>
                        </a>
                    </li>
                    <li class="page-item">
                        <a class="page-link" href="javascript:;" onclick="doSearch(2)">
                            <i class="bi bi-chevron-right"></i>
                        </a>
                    </li>
                </ul>
            </div>
        </div>
    </div>

    <div class="col-8">
        <div class="row">
            <div class="col-12">
                <div class="card card-outline card-success">
                    <div class="card-header">
                        <h5 class="mb-0">
                            <i class="bi bi-cart"></i>
                            Danh sách mặt hàng đã chọn
                        </h5>
                    </div>

                    <div class="card-body" id="shoppingCart">
                        <table class="table table-bordered table-hover align-middle">
                            <thead class="table-success">
                                <tr>
                                    <th class="text-center">#</th>
                                    <th style="width:auto">Tên hàng</th>
                                    <th class="text-center" style="width:100px">ĐVT</th>
                                    <th class="text-center" style="width:100px">SL</th>
                                    <th class="text-end" style="width:150px">Giá</th>
                                    <th class="text-end" style="width:150px">Thành tiền</th>
                                    <th style="width:80px"></th>
                                </tr>
                            </thead>
                            <tbody>
                                @for (int i = 1; i <= 3; i++)
                                {
                                    <tr>
                                        <td class="text-center">@i</td>
                                        <td>Laptop HP Gaming VICTUS</td>
                                        <td class="text-center">Bộ</td>
                                        <td class="text-center">1</td>
                                        <td class="text-end">23.990.000</td>
                                        <td class="text-end">23.990.000</td>
                                        <td class="text-end text-nowrap">
                                            <a class="btn btn-sm btn-primary open-modal" href="~/Order/EditCartItem?productId=456">
                                                <i class="bi bi-pencil"></i>
                                            </a>
                                            <button class="btn btn-sm btn-danger" onclick="removeFromCart(456)">
                                                <i class="bi bi-dash"></i>
                                            </button>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                            <tfoot>
                                <tr>
                                    <th colspan="5" class="text-end">Tổng cộng:</th>
                                    <th class="text-end">71,970,000</th>
                                    <th></th>
                                </tr>
                            </tfoot>
                        </table>

                        <div class="text-end">
                            <button class="btn btn-sm btn-danger mt-2" onclick="clearCart()">
                                <i class="bi bi-trash"></i>
                                Xóa giỏ hàng
                            </button>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="row mt-3">
            <div class="col-12">
                <div class="card card-outline card-info">
                    <div class="card-header">
                        <h5 class="mb-0">
                            <i class="bi bi-person"></i>
                            Thông tin khách hàng & nơi giao hàng
                        </h5>
                    </div>

                    <div class="card-body">
                        <form id="frmOrder" method="post">
                            <div class="row mb-3">
                                <label class="col-md-2 col-form-label">Khách hàng</label>
                                <div class="col-md-10">
                                    <select name="customerID" class="form-select select2">
                                        <option value="0">-- Chọn khách hàng --</option>
                                        @foreach (var c in ViewBag.Customers)
                                        {
                                            <option value="@c.CustomerID">@c.CustomerName</option>
                                        }
                                    </select>
                                </div>
                            </div>

                            <div class="row mb-3">
                                <label class="col-md-2 col-form-label">Tỉnh/thành</label>
                                <div class="col-md-10">
                                    <select name="province" class="form-select select2">
                                        <option value="">-- Chọn Tỉnh/thành giao hàng --</option>
                                        @foreach (var p in ViewBag.Provinces)
                                        {
                                            <option value="@p.ProvinceName">@p.ProvinceName</option>
                                        }
                                    </select>
                                </div>
                            </div>

                            <div class="row mb-3">
                                <label class="col-md-2 col-form-label">Địa chỉ giao hàng</label>
                                <div class="col-md-10">
                                    <textarea name="deliveryAddress" class="form-control" rows="3" placeholder="Nhập địa chỉ chi tiết"></textarea>
                                </div>
                            </div>

                            <div class="text-end">
                                <button type="submit" class="btn btn-primary">
                                    <i class="bi bi-check-circle"></i>
                                    Lập đơn hàng
                                </button>
                            </div>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function () {
            // Vừa vào trang là load giỏ hàng ngay
            loadShoppingCart();

            // 1. TÌM KIẾM KHÔNG LOAD TRANG
            $('#frmSearch').submit(function (e) {
                e.preventDefault(); // Ngăn chặn load lại trang
                doSearch(1); // Mặc định tìm trang 1
            });

            // 2. THÊM VÀO GIỎ KHÔNG LOAD TRANG
            $(document).on('submit', '.frmAddToCart', function (e) {
                e.preventDefault();
                var formData = $(this).serialize(); // Lấy dữ liệu (productId, quantity, salePrice)

                $.ajax({
                    url: '/Order/AddCartItem', // Gọi vào Controller
                    type: 'POST',
                    data: formData,
                    success: function (msg) {
                        if (msg === "") {
                            // Thành công -> load lại cái bảng giỏ hàng
                            loadShoppingCart();
                        } else {
                            alert(msg); // Báo lỗi nếu có
                        }
                    }
                });
            });

            // 3. LẬP ĐƠN HÀNG KHÔNG LOAD TRANG
            $('#frmOrder').submit(function (e) {
                e.preventDefault();
                
                // Kiểm tra validation
                var customerID = $('select[name="customerID"]').val();
                var deliveryProvince = $('select[name="province"]').val();
                var deliveryAddress = $('textarea[name="deliveryAddress"]').val();

                if (!customerID || customerID === "0") {
                    alert('Vui lòng chọn khách hàng!');
                    return false;
                }

                if (!deliveryProvince) {
                    alert('Vui lòng chọn tỉnh/thành giao hàng!');
                    return false;
                }

                if (!deliveryAddress || deliveryAddress.trim() === '') {
                    alert('Vui lòng nhập địa chỉ giao hàng!');
                    return false;
                }

                var formData = {
                    customerID: customerID,
                    deliveryProvince: deliveryProvince,
                    deliveryAddress: deliveryAddress
                };

                $.ajax({
                    url: '/Order/CreateOrder',
                    type: 'POST',
                    data: formData,
                    success: function (res) {
                        if (!isNaN(res)) {
                            // res là mã đơn hàng (số) -> Lập thành công, chuyển sang trang Chi tiết
                            window.location.href = '/Order/Details/' + res;
                        } else {
                            // res là chuỗi báo lỗi
                            alert(res);
                        }
                    },
                    error: function() {
                        alert('Có lỗi xảy ra. Vui lòng thử lại!');
                    }
                });
            });
        });

        // Hàm gọi AJAX tìm kiếm sản phẩm
        function doSearch(page) {
            var keyword = $('#frmSearch input[name="searchValue"]').val();
            $.ajax({
                url: '/Order/SearchProduct',
                type: 'GET',
                data: { keyword: keyword, page: page },
                success: function (data) {
                    $('#searchResult').html(data); // Đổ dữ liệu HTML mới vào khu vực tìm kiếm
                }
            });
        }

        // Hàm gọi AJAX lấy bảng giỏ hàng mới nhất
        function loadShoppingCart() {
            $.ajax({
                url: '/Order/ShowCart',
                type: 'GET',
                success: function (data) {
                    $('#shoppingCart').html(data); // Cập nhật lại cái bảng giỏ hàng
                }
            });
        }

        // Hàm gọi AJAX xóa 1 mặt hàng
        function removeFromCart(id) {
            if(confirm('Xóa mặt hàng này khỏi giỏ?')) {
                $.ajax({
                    url: '/Order/DeleteCartItem',
                    type: 'POST',
                    data: { productId: id },
                    success: function () {
                        loadShoppingCart();
                    }
                });
            }
        }

        // Hàm gọi AJAX xóa toàn bộ giỏ
        function clearCart() {
            if(confirm('Xóa sạch giỏ hàng?')) {
                $.ajax({
                    url: '/Order/ClearCartConfirmed',
                    type: 'POST',
                    success: function () {
                        loadShoppingCart();
                    }
                });
            }
        }
    </script>
}