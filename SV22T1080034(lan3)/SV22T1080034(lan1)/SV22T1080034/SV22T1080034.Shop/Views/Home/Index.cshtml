@using SV22T1080034.DomainModels.Catalog
@using SV22T1080034.DomainModels.Common

@{
    ViewBag.Title = "Trang chủ - Thang Shop";
}

@section Styles {
    <style>
        .feature-card {
            background: white;
            border-radius: 16px;
            padding: 40px 30px;
            text-align: center;
            box-shadow: 0 4px 15px rgba(0,0,0,0.06);
            transition: all 0.3s ease;
            height: 100%;
        }

            .feature-card:hover {
                transform: translateY(-8px);
                box-shadow: 0 12px 30px rgba(102, 126, 234, 0.2);
            }

            .feature-card i {
                font-size: 3rem;
                background: linear-gradient(135deg, var(--primary-color) 0%, var(--secondary-color) 100%);
                -webkit-background-clip: text;
                -webkit-text-fill-color: transparent;
                background-clip: text;
                margin-bottom: 20px;
            }

        .testimonial-card {
            background: white;
            border-radius: 16px;
            padding: 25px;
            box-shadow: 0 4px 15px rgba(0,0,0,0.06);
            height: 100%;
        }

            .testimonial-card .stars {
                color: #ffc107;
                margin-bottom: 15px;
            }

            .testimonial-card .author {
                font-weight: 600;
                color: #333;
            }

            .testimonial-card .role {
                color: #6c757d;
                font-size: 0.9rem;
            }

        .newsletter-section {
            background: linear-gradient(135deg, var(--primary-color) 0%, var(--secondary-color) 100%);
            border-radius: 20px;
            padding: 40px;
            color: white;
            text-align: center;
        }

            .newsletter-section h3 {
                font-weight: 700;
            }

            .newsletter-section .form-control {
                border: none;
                border-radius: 50px;
                padding: 12px 20px;
            }

            .newsletter-section .btn {
                border-radius: 50px;
                padding: 12px 30px;
                font-weight: 600;
            }

        .cta-banner {
            background: linear-gradient(135deg, rgba(46, 204, 113, 0.1) 0%, rgba(39, 174, 96, 0.1) 100%);
            border-radius: 20px;
            padding: 40px;
            margin-top: 40px;
            text-align: center;
            border: 2px dashed #2ecc71;
        }

        /* Featured Products Section */
        .featured-product-card {
            background: white;
            border-radius: 12px;
            overflow: hidden;
            box-shadow: 0 4px 6px rgba(0,0,0,.05);
            transition: transform 0.3s ease, box-shadow 0.3s ease;
            height: 100%;
        }

            .featured-product-card:hover {
                transform: translateY(-8px);
                box-shadow: 0 12px 24px rgba(0,0,0,.15);
            }

        .featured-product-image {
            height: 200px;
            object-fit: cover;
            width: 100%;
        }

        .featured-product-price {
            color: #dc3545;
            font-size: 1.1rem;
            font-weight: bold;
        }

        .badge-hot {
            background: linear-gradient(135deg, #ff6b6b 0%, #ee5a24 100%);
            color: white;
            padding: 5px 12px;
            border-radius: 20px;
            font-size: 0.75rem;
            font-weight: 600;
        }

        .badge-new {
            background: linear-gradient(135deg, #20bf6b 0%, #26de81 100%);
            color: white;
            padding: 5px 12px;
            border-radius: 20px;
            font-size: 0.75rem;
            font-weight: 600;
        }

        .featured-product-card {
            background: white;
            border-radius: 12px;
            overflow: hidden;
            box-shadow: 0 4px 6px rgba(0,0,0,.05);
            transition: transform 0.3s ease, box-shadow 0.3s ease;
            height: 100%;
            position: relative;
        }

            .featured-product-card:hover {
                transform: translateY(-8px);
                box-shadow: 0 12px 24px rgba(0,0,0,.15);
            }

        .featured-product-image {
            height: 200px;
            object-fit: cover;
            width: 100%;
        }

        .featured-product-price {
            color: #dc3545;
            font-size: 1.1rem;
            font-weight: bold;
        }

        .badge-hot {
            background: linear-gradient(135deg, #ff6b6b 0%, #ee5a24 100%);
            color: white;
            padding: 5px 12px;
            border-radius: 20px;
            font-size: 0.75rem;
            font-weight: 600;
        }

        .category-card {
            background: white;
            border-radius: 16px;
            padding: 30px 20px;
            text-align: center;
            box-shadow: 0 4px 15px rgba(0,0,0,0.06);
            transition: all 0.4s cubic-bezier(0.4, 0, 0.2, 1);
            cursor: pointer;
            height: 100%;
            text-decoration: none;
            color: inherit;
            border: 2px solid transparent;
            position: relative;
            overflow: hidden;
        }

            .category-card::before {
                content: '';
                position: absolute;
                top: 0;
                left: 0;
                width: 100%;
                height: 100%;
                background: linear-gradient(135deg, rgba(102, 126, 234, 0.1) 0%, rgba(118, 75, 162, 0.1) 100%);
                opacity: 0;
                transition: opacity 0.3s ease;
                z-index: 0;
            }

            .category-card:hover::before {
                opacity: 1;
            }

            .category-card:hover {
                transform: translateY(-12px) scale(1.02);
                box-shadow: 0 20px 40px rgba(102, 126, 234, 0.25);
                border-color: #667eea;
            }

            .category-card .category-icon {
                width: 90px;
                height: 90px;
                margin: 0 auto 20px;
                background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
                border-radius: 50%;
                display: flex;
                align-items: center;
                justify-content: center;
                font-size: 2.2rem;
                color: white;
                transition: all 0.3s ease;
                position: relative;
                z-index: 1;
                box-shadow: 0 8px 20px rgba(102, 126, 234, 0.3);
            }

                .category-card:hover .category-icon {
                    transform: scale(1.1) rotate(5deg);
                    box-shadow: 0 12px 28px rgba(102, 126, 234, 0.4);
                }

            .category-card h5 {
                color: #333;
                font-weight: 600;
                margin-bottom: 0;
                font-size: 1.1rem;
                position: relative;
                z-index: 1;
                transition: color 0.3s ease;
            }

                .category-card:hover h5 {
                    color: #667eea;
                }

            .category-card .category-count {
                position: absolute;
                bottom: 10px;
                right: 10px;
                background: rgba(102, 126, 234, 0.1);
                color: #667eea;
                padding: 4px 10px;
                border-radius: 20px;
                font-size: 0.75rem;
                font-weight: 600;
                opacity: 0;
                transform: translateY(10px);
                transition: all 0.3s ease;
                z-index: 1;
            }

            .category-card:hover .category-count {
                opacity: 1;
                transform: translateY(0);
            }
    </style>
}

@if (User.Identity?.IsAuthenticated != true)
{
    <div class="container" style="padding-top: 20px;">
        <div class="alert alert-info alert-dismissible fade show" role="alert" data-aos="fade-down">
            <i class="bi bi-info-circle me-2"></i>
            <strong>Chào mừng!</strong> Đăng ký tài khoản để nhận ưu đãi đặc biệt và theo dõi đơn hàng dễ dàng.
            <a asp-controller="Account" asp-action="Register" class="alert-link fw-bold">Đăng ký ngay</a>
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    </div>
}


@if (ViewBag.RandomProducts != null && ((List<SV22T1080034.DomainModels.Catalog.Product>)ViewBag.RandomProducts).Any())
{
    <section class="section-spacing bg-light">
        <div class="container">
            <div class="section-header" data-aos="fade-up">
                <h2><i class="bi bi-stars me-2"></i>Sản phẩm nổi bật</h2>
                <p class="text-muted">Khám phá những sản phẩm được chọn lọc</p>
            </div>
            <div class="row g-4">
                @foreach (var product in (List<SV22T1080034.DomainModels.Catalog.Product>)ViewBag.RandomProducts)
                {
                    <div class="col-6 col-md-4 col-lg-3" data-aos="fade-up" data-aos-delay="100">
                        <div class="featured-product-card position-relative">
                            <div class="product-image-wrapper">
                                <a asp-controller="Product" asp-action="Details" asp-route-id="@product.ProductID" class="text-decoration-none">
                                    <img src="@(string.IsNullOrEmpty(product.Photo) ? "/images/products/nophoto.png" : $"/images/products/{product.Photo}")"
                                         class="featured-product-image"
                                         alt="@product.ProductName"
                                         loading="lazy"
                                         onerror="this.onerror=null; this.src='/images/products/nophoto.png'">
                                </a>
                                @if (product.IsSelling)
                                {
                                    <span class="badge-hot position-absolute top-0 end-0 m-2">HOT</span>
                                }
                            </div>
                            <div class="card-body p-3">
                                <h6 class="card-title mb-2">
                                    <a asp-controller="Product" asp-action="Details" asp-route-id="@product.ProductID" class="text-decoration-none text-dark">
                                        @product.ProductName
                                    </a>
                                </h6>
                                <p class="text-muted small mb-2">@product.CategoryName</p>
                                <p class="featured-product-price">
                                    @product.Price.ToString("N0") ₫
                                </p>
                            </div>
                        </div>
                    </div>
                }
            </div>
            <div class="text-center mt-4">
                <a asp-controller="Product" asp-action="Index" class="btn btn-outline-primary">
                    <i class="bi bi-box-seam me-2"></i>Xem tất cả sản phẩm
                </a>
            </div>
        </div>
    </section>
}

@if (ViewBag.Categories != null && ((List<SV22T1080034.DomainModels.Catalog.Category>)ViewBag.Categories).Any())
{
    <section class="section-spacing bg-light">
        <div class="container">
            <div class="section-header" data-aos="fade-up">
                <h2><i class="bi bi-grid-3x3-gap me-2"></i>Danh mục sản phẩm</h2>
                <p class="text-muted">Khám phá các danh mục sản phẩm của chúng tôi</p>
            </div>
            <div class="row g-4">
                @foreach (var category in (List<SV22T1080034.DomainModels.Catalog.Category>)ViewBag.Categories)
                {
                    <div class="col-6 col-md-4 col-lg-3" data-aos="fade-up" data-aos-delay="100">
                        <a asp-controller="Product" asp-action="Index" asp-route-categoryID="@category.CategoryID" class="text-decoration-none">
                            <div class="category-card">
                                <div class="category-icon">
                                    <i class="bi bi-box-seam"></i>
                                </div>
                                <h5>@category.CategoryName</h5>
                            </div>
                        </a>
                    </div>
                }
            </div>
        </div>
    </section>
}

<section class="section-spacing bg-light">
    <div class="container">
        <div class="section-header" data-aos="fade-up">
            <h2><i class="bi bi-award me-2"></i>Tại sao chọn chúng tôi?</h2>
        </div>
        <div class="row g-4">
            <div class="col-md-3" data-aos="fade-up" data-aos-delay="100">
                <div class="feature-card card-lift">
                    <i class="bi bi-truck"></i>
                    <h5>Giao hàng nhanh</h5>
                    <p class="text-muted">Giao hàng trong 24-48 giờ toàn quốc</p>
                </div>
            </div>
            <div class="col-md-3" data-aos="fade-up" data-aos-delay="200">
                <div class="feature-card card-lift">
                    <i class="bi bi-shield-check"></i>
                    <h5>Chất lượng đảm bảo</h5>
                    <p class="text-muted">100% sản phẩm chính hãng</p>
                </div>
            </div>
            <div class="col-md-3" data-aos="fade-up" data-aos-delay="300">
                <div class="feature-card card-lift">
                    <i class="bi bi-arrow-repeat"></i>
                    <h5>Đổi trả dễ dàng</h5>
                    <p class="text-muted">Đổi trả trong 7 ngày nếu không hài lòng</p>
                </div>
            </div>
            <div class="col-md-3" data-aos="fade-up" data-aos-delay="400">
                <div class="feature-card card-lift">
                    <i class="bi bi-headset"></i>
                    <h5>Hỗ trợ 24/7</h5>
                    <p class="text-muted">Luôn sẵn sàng hỗ trợ bạn</p>
                </div>
            </div>
        </div>
    </div>
</section>


<section class="section-spacing">
    <div class="container">
        <div class="cta-banner" data-aos="zoom-in">
            <h3><i class="bi bi-megaphone me-2"></i>Ưu đãi đặc biệt</h3>
            <p class="mb-4">Giảm ngay <strong>20%</strong> cho đơn hàng đầu tiên. Voucher: <code class="bg-white text-primary px-2 py-1 rounded">FIRST20</code></p>
            <a asp-controller="Product" asp-action="Index" class="btn btn-success btn-lg">
                <i class="bi bi-bag me-2"></i>Mua ngay
            </a>
        </div>
    </div>
</section>

<!-- Newsletter -->
<section class="section-spacing mb-5">
    <div class="container">
        <div class="newsletter-section" data-aos="fade-up">
            <h3 class="mb-3"><i class="bi bi-envelope me-2"></i>Đăng ký nhận tin</h3>
            <p class="mb-4">Nhận thông tin về khuyến mãi và sản phẩm mới</p>
            <form method="post" asp-controller="Home" asp-action="Subscribe" class="row g-3 justify-content-center">
                @Html.AntiForgeryToken()
                <div class="col-md-6">
                    <input type="email" name="email" class="form-control" placeholder="Nhập email của bạn..." required>
                </div>
                <div class="col-md-2">
                    <button type="submit" class="btn btn-light w-100">
                        <i class="bi bi-send me-2"></i>Đăng ký
                    </button>
                </div>
            </form>
        </div>
    </div>
</section>

@section Scripts {
    <script>
        // Newsletter subscription
        document.addEventListener('DOMContentLoaded', function() {
            const newsletterForm = document.querySelector('form[action*="Subscribe"]');
            if (newsletterForm) {
                newsletterForm.addEventListener('submit', async function(e) {
                    e.preventDefault();

                    const formData = new FormData(this);
                    const token = document.querySelector('input[name="__RequestVerificationToken"]')?.value;
                    if (token) formData.append('__RequestVerificationToken', token);

                    try {
                        const response = await fetch(this.action, {
                            method: 'POST',
                            body: formData
                        });

                        const result = await response.text();
                        // Redirect sau khi subscribe thành công (server sẽ redirect về với TempData)
                        window.location.reload();
                    } catch (error) {
                        showAlert('Có lỗi xảy ra. Vui lòng thử lại.', 'error');
                    }
                });
            }

            // Quick view functionality
            document.querySelectorAll('.quick-view-btn').forEach(btn => {
                btn.addEventListener('click', async function() {
                    const productId = this.getAttribute('data-product-id');
                    window.location.href = `/Product/Details/${productId}`;
                });
            });
        });
    </script>
}
