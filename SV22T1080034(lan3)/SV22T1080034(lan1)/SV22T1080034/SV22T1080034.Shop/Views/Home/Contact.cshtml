@{
    ViewBag.Title = "Liên hệ - Thang Shop";
}

<div class="container mt-5" style="padding-top: 80px;">
    <div class="row" data-aos="fade-up">
        <div class="col-lg-8 mx-auto">
            <div class="text-center mb-5">
                <h1 class="display-4 fw-bold text-primary"><i class="bi bi-envelope me-2"></i>Liên hệ chúng tôi</h1>
                <p class="lead text-muted">Chúng tôi luôn sẵn sàng hỗ trợ bạn</p>
            </div>

            <div class="row g-4 mb-4">
                <div class="col-md-4">
                    <div class="card h-100 border-0 shadow-sm text-center">
                        <div class="card-body p-4">
                            <i class="bi bi-geo-alt fs-1 text-danger"></i>
                            <h5 class="mt-3">Địa chỉ</h5>
                            <p class="text-muted mb-0">123 Đường ABC<br>Quận XYZ, TP.HCM</p>
                        </div>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="card h-100 border-0 shadow-sm text-center">
                        <div class="card-body p-4">
                            <i class="bi bi-telephone fs-1 text-success"></i>
                            <h5 class="mt-3">Điện thoại</h5>
                            <p class="text-muted mb-0">Hotline: 0909.999.999<br>Thời gian: 8:00 - 21:00</p>
                        </div>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="card h-100 border-0 shadow-sm text-center">
                        <div class="card-body p-4">
                            <i class="bi bi-envelope fs-1 text-primary"></i>
                            <h5 class="mt-3">Email</h5>
                            <p class="text-muted mb-0">contact@liteshop.vn<br>support@liteshop.vn</p>
                        </div>
                    </div>
                </div>
            </div>

            <div class="card shadow border-0 rounded-4">
                <div class="card-body p-5">
                    <h3 class="mb-4"><i class="bi bi-chat-dots me-2"></i>Gửi tin nhắn</h3>

                    @if (TempData["SuccessMessage"] != null)
                    {
                        <div class="alert alert-success alert-dismissible fade show" role="alert">
                            <i class="bi bi-check-circle-fill me-2"></i>@TempData["SuccessMessage"]
                            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                        </div>
                    }

                    <form method="post" action="/Home/Contact">
                        @Html.AntiForgeryToken()
                        <div class="row g-3">
                            <div class="col-md-6">
                                <label class="form-label">Họ và tên <span class="text-danger">*</span></label>
                                <input type="text" name="name" class="form-control" placeholder="Nhập họ và tên" required>
                            </div>
                            <div class="col-md-6">
                                <label class="form-label">Email <span class="text-danger">*</span></label>
                                <input type="email" name="email" class="form-control" placeholder="Nhập email" required>
                            </div>
                            <div class="col-12">
                                <label class="form-label">Chủ đề <span class="text-danger">*</span></label>
                                <input type="text" name="subject" class="form-control" placeholder="Nhập chủ đề" required>
                            </div>
                            <div class="col-12">
                                <label class="form-label">Nội dung <span class="text-danger">*</span></label>
                                <textarea name="message" class="form-control" rows="5" placeholder="Nhập nội dung tin nhắn" required></textarea>
                            </div>
                        </div>
                        <div class="mt-3">
                            <button type="submit" class="btn btn-primary">
                                <i class="bi bi-send me-2"></i>Gửi tin nhắn
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>
