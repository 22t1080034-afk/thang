@using SV22T1080034.DomainModels.Catalog
@using SV22T1080034.DomainModels.Common
@model PagedResult<Product>

@{
    ViewBag.Title = "Danh sách sản phẩm - Thang Shop";
    var categorySelectList = new SelectList(
        ViewBag.Categories as List<Category> ?? new List<Category>(),
        "CategoryID",
        "CategoryName",
        ViewBag.CategoryID
    );
    var pageSizeSelectList = new SelectList(
        new[] { new { Value = 12, Text = "12" }, new { Value = 24, Text = "24" }, new { Value = 36, Text = "36" } },
        "Value",
        "Text",
        ViewBag.PageSize ?? 12
    );
}

@section Styles {
    <style>
        .product-card {
            border: 1px solid rgba(0,0,0,0.06);
            transition: all 0.2s ease;
            border-radius: 12px;
            overflow: hidden;
        }

            .product-card:hover {
                transform: translateY(-5px);
                box-shadow: 0 8px 20px rgba(0,0,0,.1) !important;
                border-color: #667eea;
            }

        .product-badge .badge {
            padding: 4px 8px;
            font-size: 0.7rem;
            font-weight: 600;
            box-shadow: 0 1px 4px rgba(0,0,0,0.1);
        }

        .product-image-wrapper {
            height: 160px;
            position: relative;
            overflow: hidden;
            background: #f8f9fa;
        }

        .product-image {
            height: 100%;
            object-fit: cover;
            width: 100%;
            transition: transform 0.3s ease;
        }

        .product-card:hover .product-image {
            transform: scale(1.05);
        }

        .card-body {
            padding: 0.75rem;
        }

        .card-title {
            font-size: 0.95rem;
            margin-bottom: 0.35rem;
            line-height: 1.3;
            display: -webkit-box;
            -webkit-line-clamp: 2;
            -webkit-box-orient: vertical;
            overflow: hidden;
        }

        .product-price {
            font-size: 0.95rem;
            font-weight: 700;
            color: #dc3545;
        }

        .category-badge {
            font-size: 0.7rem;
            padding: 0.25rem 0.5rem;
        }

        .btn-sm {
            padding: 0.25rem 0.5rem;
            font-size: 0.8rem;
        }

        .pagination .page-link {
            padding: 0.4rem 0.6rem;
            font-size: 0.85rem;
        }

        .empty-state {
            border-radius: 16px;
            background: white;
            padding: 60px 20px;
        }

        /* AOS animation optimized */
        [data-aos] {
            transition-duration: 0.3s !important;
        }

        /* Filter Box Styling */
        .filter-box {
            background: #fff;
            padding: 15px;
            border-radius: 14px;
            box-shadow: 0 4px 20px rgba(0,0,0,0.06);
        }

        /* input có icon */
        .filter-group {
            position: relative;
        }

        .filter-group i {
            position: absolute;
            top: 50%;
            left: 10px;
            transform: translateY(-50%);
            color: #999;
        }

        .filter-group input {
            padding-left: 35px;
            border-radius: 10px;
        }

        /* select đẹp hơn */
        .filter-select {
            border-radius: 10px;
        }

        /* giá */
        .price-range {
            display: flex;
            align-items: center;
            gap: 5px;
        }

        .price-range input {
            border-radius: 10px;
        }

        /* hover đẹp hơn */
        .filter-box input:focus,
        .filter-box select:focus {
            border-color: #667eea;
            box-shadow: 0 0 0 0.15rem rgba(102,126,234,0.2);
        }

        /* Nút X đẹp hơn */
        .filter-box .btn-outline-danger {
            border-width: 2px;
            padding: 0.375rem 0.75rem;
            transition: all 0.2s ease;
            display: flex;
            align-items: center;
            justify-content: center;
        }

            .filter-box .btn-outline-danger:hover {
                background-color: #dc3545;
                border-color: #dc3545;
                transform: scale(1.05);
            }

        .filter-box .d-flex.gap-2 {
            flex-wrap: nowrap;
        }

        .filter-box .btn-primary {
            display: flex;
            align-items: center;
            justify-content: center;
            white-space: nowrap;
        }
    </style>
}

<div class="container mt-4" style="padding-top: 80px;">
    <!-- Filter Section -->
    <div class="filter-box mb-4" data-aos="fade-up">
        <form method="get" asp-controller="Product" asp-action="Index" class="row g-3 align-items-end">

            <!-- Search -->
            <div class="col-12 col-md-5">
                <div class="filter-group">
                    <i class="bi bi-search"></i>
                    <input type="text" name="searchValue" class="form-control"
                           value="@(ViewBag.SearchValue ?? "")"
                           placeholder="Tìm sản phẩm...">
                </div>
            </div>

            <!-- Category -->
            <div class="col-6 col-md-2">
                <select name="categoryID" asp-items="categorySelectList" class="form-select filter-select">
                    <option value="0">Tất cả loại hàng</option>
                </select>
            </div>

            <!-- Price range -->
            <div class="col-6 col-md-2">
                <div class="price-range">
                    <input type="number" name="minPrice" class="form-control"
                           value="@ViewBag.MinPrice" placeholder="Từ">
                    <span>-</span>
                    <input type="number" name="maxPrice" class="form-control"
                           value="@ViewBag.MaxPrice" placeholder="Đến">
                </div>
            </div>

            <!-- Buttons -->
            <div class="col-6 col-md-2 d-flex gap-2">
                <button type="submit" class="btn btn-primary flex-fill">
                    <i class="bi bi-search me-1"></i>Tìm
                </button>
                <a asp-controller="Product" asp-action="Index" class="btn btn-outline-danger" title="Xóa bộ lọc">
                    <i class="bi bi-x-lg"></i>
                </a>
            </div>

        </form>
    </div>

    @if (Model.DataItems.Any())
    {
        <div class="row g-3">
            @foreach (var product in Model.DataItems)
            {
                <div class="col-6 col-md-4 col-lg-3" data-aos="fade-up" data-aos-delay="100">
                    <div class="product-card h-100 position-relative">
                        <!-- Badges -->
                        <div class="product-badge">
                            @if (product.IsSelling)
                            {
                                <span class="badge bg-success">Hot</span>
                            }
                            else
                            {
                                <span class="badge bg-danger">Ngừng bán</span>
                            }
                        </div>

                        <div class="product-image-wrapper">
                            <a asp-controller="Product" asp-action="Details" asp-route-id="@product.ProductID" class="text-decoration-none text-dark">
                                <img src="@(string.IsNullOrEmpty(product.Photo) ? "/images/products/nophoto.png" : $"/images/products/{product.Photo}")"
                                     class="product-image" alt="@product.ProductName"
                                     loading="lazy"
                                     onerror="this.onerror=null; this.src='/images/products/nophoto.png'">
                            </a>
                        </div>

                        <div class="card-body p-2">
                            <h6 class="card-title mb-1 text-dark">
                                <a asp-controller="Product" asp-action="Details" asp-route-id="@product.ProductID" class="text-decoration-none text-dark">
                                    @product.ProductName
                                </a>
                            </h6>
                            <p class="mb-1 small text-muted">
                                <small><i class="bi bi-box-seam me-1"></i>@product.CategoryName</small>
                            </p>
                            <p class="mb-2">
                                <span class="product-price fw-bold">@product.Price.ToString("N0") ₫</span>
                            </p>
                        </div>

                        <div class="card-footer bg-white p-2 pt-0">
                            <div class="d-flex gap-1">
                                @if (User.Identity?.IsAuthenticated == true)
                                {
                                    <button class="btn btn-sm btn-primary add-to-cart-btn w-100"
                                            data-product-id="@product.ProductID"
                                            data-product-name="@product.ProductName"
                                            data-price="@product.Price"
                                            title="Thêm vào giỏ">
                                        <i class="bi bi-cart-plus me-1"></i>Thêm
                                    </button>
                                }
                                else
                                {
                                    <a asp-controller="Account" asp-action="Login" class="btn btn-sm btn-outline-primary w-100">
                                        <i class="bi bi-box-arrow-in-right me-1"></i>Đăng nhập
                                    </a>
                                }
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>

        @if (Model.RowCount > Model.PageSize)
        {
            int totalPages = (int)Math.Ceiling((double)Model.RowCount / Model.PageSize);
            int currentPage = Model.Page;
            int maxPagesToShow = 7;

            <nav class="mt-4" aria-label="Page navigation">
                <ul class="pagination justify-content-center">

                    <li class="page-item @(currentPage == 1 ? "disabled" : "")">
                        <a class="page-link" href="?page=@(currentPage - 1)&pageSize=@Model.PageSize&searchValue=@ViewBag.SearchValue&categoryID=@ViewBag.CategoryID&minPrice=@ViewBag.MinPrice&maxPrice=@ViewBag.MaxPrice">
                            <i class="bi bi-chevron-left"></i>
                        </a>
                    </li>

                    @{
                        int startPage = 1;
                        int endPage = totalPages;

                        if (totalPages <= maxPagesToShow)
                        {
                            startPage = 1;
                            endPage = totalPages;
                        }
                        else
                        {
                            int halfMax = maxPagesToShow / 2;
                            startPage = Math.Max(1, currentPage - halfMax);
                            endPage = Math.Min(totalPages, startPage + maxPagesToShow - 1);

                            if (endPage - startPage + 1 < maxPagesToShow)
                            {
                                startPage = Math.Max(1, endPage - maxPagesToShow + 1);
                            }
                        }

                        if (startPage > 1)
                        {
                            <li class="page-item"><a class="page-link" href="?page=1&pageSize=@Model.PageSize&searchValue=@ViewBag.SearchValue&categoryID=@ViewBag.CategoryID&minPrice=@ViewBag.MinPrice&maxPrice=@ViewBag.MaxPrice">1</a></li>
                        }

                        if (startPage > 2)
                        {
                            <li class="page-item disabled"><span class="page-link">...</span></li>
                        }

                        for (int i = startPage; i <= endPage; i++)
                        {
                            <li class="page-item @(i == currentPage ? "active" : "")">
                                <a class="page-link" href="?page=@i&pageSize=@Model.PageSize&searchValue=@ViewBag.SearchValue&categoryID=@ViewBag.CategoryID&minPrice=@ViewBag.MinPrice&maxPrice=@ViewBag.MaxPrice">@i</a></li>
                        }

                        if (endPage < totalPages - 1)
                        {
                            <li class="page-item disabled"><span class="page-link">...</span></li>
                        }

                        if (endPage < totalPages)
                        {
                            <li class="page-item"><a class="page-link" href="?page=@totalPages&pageSize=@Model.PageSize&searchValue=@ViewBag.SearchValue&categoryID=@ViewBag.CategoryID&minPrice=@ViewBag.MinPrice&maxPrice=@ViewBag.MaxPrice">@totalPages</a></li>
                        }
                    }

                    <li class="page-item @(currentPage == totalPages ? "disabled" : "")">
                        <a class="page-link" href="?page=@(currentPage + 1)&pageSize=@Model.PageSize&searchValue=@ViewBag.SearchValue&categoryID=@ViewBag.CategoryID&minPrice=@ViewBag.MinPrice&maxPrice=@ViewBag.MaxPrice">
                            <i class="bi bi-chevron-right"></i>
                        </a>
                    </li>
                </ul>
            </nav>
        }
    }
    else
    {
        <div class="empty-state" style="border-radius: 20px; background: white;">
            <i class="bi bi-search fs-1 text-muted"></i>
            <h4 class="mt-3">Không tìm thấy sản phẩm</h4>
            <p class="text-muted mb-4">Vui lòng thử lại với từ khóa khác hoặc xem toàn bộ sản phẩm.</p>
            <div class="d-flex gap-2 justify-content-center flex-wrap">
                <a asp-controller="Product" asp-action="Index" class="btn btn-primary">
                    <i class="bi bi-box-seam me-2"></i>Xem tất cả sản phẩm
                </a>
                <a asp-controller="Home" asp-action="Index" class="btn btn-outline-secondary">
                    <i class="bi bi-house me-2"></i>Về trang chủ
                </a>
            </div>
        </div>
    }
</div>

@section Scripts {
    <script>
        // Simple toast notification
        function showToast(message, type = 'info') {
            const toastId = 'toast-' + Date.now();
            const bgClass = type === 'success' ? 'bg-success' : type === 'error' ? 'bg-danger' : 'bg-info';
            const toastHtml = `
                <div id="${toastId}" class="toast align-items-center text-white ${bgClass} border-0" role="alert" style="position: fixed; top: 20px; right: 20px; z-index: 9999;">
                    <div class="d-flex">
                        <div class="toast-body">${message}</div>
                        <button type="button" class="btn-close btn-close-white me-2 m-auto" data-bs-dismiss="toast"></button>
                    </div>
                </div>`;
            document.body.insertAdjacentHTML('beforeend', toastHtml);
            const toast = new bootstrap.Toast(document.getElementById(toastId), { delay: 3000 });
            toast.show();
            document.getElementById(toastId).addEventListener('hidden.bs.toast', () => document.getElementById(toastId)?.remove());
        }

        // Single image fetch
        async function fetchSingleImage(productId, button) {
            const productName = button.getAttribute('data-product-name');
            const originalText = button.innerHTML;

            button.innerHTML = '<i class="bi bi-hourglass-split"></i> Đang tải...';
            button.disabled = true;

            try {
                const response = await fetch(`/Product/AutoFetchImage/${productId}`);
                const result = await response.json();

                if (result.success) {
                    // Update image src with timestamp to avoid cache
                    const imgElement = document.getElementById(`img-${productId}`);
                    if (imgElement) {
                        const newSrc = `/images/products/${result.photo}?t=${Date.now()}`;
                        imgElement.src = newSrc;
                        imgElement.onerror = () => imgElement.src = '/images/products/nophoto.png';

                        // Hide the fetch button
                        button.parentElement.style.display = 'none';
                    }
                    showToast(`✅ Đã tải ảnh cho: ${productName}`, 'success');
                } else {
                    showToast(`❌ Lỗi: ${result.message}`, 'error');
                    button.innerHTML = originalText;
                    button.disabled = false;
                }
            } catch (e) {
                console.error('Fetch single image error:', e);
                showToast('Có lỗi xảy ra khi tải ảnh.', 'error');
                button.innerHTML = originalText;
                button.disabled = false;
            }
        }

        // Bulk fetch images
        async function bulkFetchImages() {
            if (!confirm('Tự động tải ảnh cho tất cả sản phẩm chưa có ảnh? Quá trình này có thể mất từ 1-5 phút tùy số lượng.')) {
                return;
            }

            const btn = document.getElementById('bulkFetchBtn');
            const originalText = btn.innerHTML;
            btn.innerHTML = '<i class="bi bi-hourglass-split"></i> Đang xử lý...';
            btn.disabled = true;

            try {
                const response = await fetch('/Product/BulkFetchImages?limit=50');
                const result = await response.json();

                if (result.success) {
                    const message = `${result.message}\nThành công: ${result.successCount}\nThất bại: ${result.failedCount}`;
                    alert(message);
                    // Reload page sau 2 giây để cập nhật ảnh
                    setTimeout(() => window.location.reload(), 2000);
                } else {
                    alert('Lỗi: ' + result.message);
                    btn.innerHTML = originalText;
                    btn.disabled = false;
                }
            } catch (e) {
                console.error('Bulk fetch error:', e);
                alert('Có lỗi xảy ra khi gọi API.');
                btn.innerHTML = originalText;
                btn.disabled = false;
            }
        }

        // Quick view functionality
        document.addEventListener('DOMContentLoaded', function() {
            document.querySelectorAll('.quick-view-btn').forEach(btn => {
                btn.addEventListener('click', async function() {
                    const productId = this.getAttribute('data-product-id');
                    // TODO: Implement quick view modal
                    window.location.href = `/Product/Details/${productId}`;
                });
            });

            // Price range slider sync
            const priceRange = document.getElementById('priceRange');
            const maxPriceInput = document.querySelector('input[name="maxPrice"]');
            if (priceRange && maxPriceInput) {
                // Set initial value
                const currentMax = parseFloat(maxPriceInput.value) || 10000000;
                priceRange.value = currentMax;
                priceRange.max = Math.max(currentMax, 10000000);

                // Update maxPrice when slider changes
                priceRange.addEventListener('input', function() {
                    maxPriceInput.value = this.value;
                });

                // Update slider when maxPrice input changes manually
                maxPriceInput.addEventListener('input', function() {
                    const val = parseFloat(this.value) || 0;
                    if (val <= parseFloat(priceRange.max)) {
                        priceRange.value = val;
                    }
                });
            }
        });
    </script>
}
