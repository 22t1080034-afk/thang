@{
    var currentController = ViewContext.RouteData.Values["controller"]?.ToString();
    var currentAction = ViewContext.RouteData.Values["action"]?.ToString();
}

<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewBag.Title - Thang Shop</title>

    <!-- Bootstrap 5 CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <!-- Bootstrap Icons -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.0/font/bootstrap-icons.css">
    <!-- AOS Animation -->
    <link href="https://unpkg.com/aos@2.3.1/dist/aos.css" rel="stylesheet">

    <style>
        :root {
            --primary-color: #667eea;
            --secondary-color: #764ba2;
        }

        body {
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            background-color: #f8f9fa;
        }

        /* Navbar */
        .navbar {
            box-shadow: 0 2px 4px rgba(0,0,0,.08);
            background: linear-gradient(135deg, var(--primary-color) 0%, var(--secondary-color) 100%) !important;
        }

        .navbar-brand {
            font-weight: bold;
            font-size: 1.5rem;
            color: white !important;
        }

        .nav-link {
            font-weight: 500;
            color: rgba(255,255,255,0.9) !important;
            transition: all 0.3s ease;
        }

            .nav-link:hover {
                color: white !important;
                transform: translateY(-2px);
            }

        .cart-badge {
            position: absolute;
            top: -8px;
            right: -8px;
            font-size: 0.75rem;
            padding: 0.25em 0.5em;
            transition: transform 0.3s ease, box-shadow 0.3s ease;
        }

            .cart-badge.bounce {
                animation: bounce 0.5s ease;
            }

        .nav-link .bi-cart3 {
            transition: transform 0.3s ease, color 0.3s ease;
        }

        .nav-link:hover .bi-cart3 {
            transform: scale(1.3) rotate(10deg);
            color: #ffd700 !important;
        }

        @@keyframes bounce {
            0%, 100% {
                transform: translate(-50%, -50%) scale(1);
            }

            50% {
                transform: translate(-50%, -50%) scale(1.4);
            }
        }

        /* Hero Section */
        .hero-section {
            background: linear-gradient(135deg, rgba(102, 126, 234, 0.9) 0%, rgba(118, 75, 162, 0.9) 100%), url('https://images.unsplash.com/photo-1441986300917-64674bd600d8?ixlib=rb-4.0.3') center/cover;
            color: white;
            padding: 80px 0;
            margin-bottom: 40px;
        }

        /* Product Card */
        .product-card {
            background: white;
            border-radius: 12px;
            overflow: hidden;
            box-shadow: 0 4px 6px rgba(0,0,0,.05);
            transition: transform 0.3s ease, box-shadow 0.3s ease;
            height: 100%;
        }

            .product-card:hover {
                transform: translateY(-8px);
                box-shadow: 0 12px 24px rgba(0,0,0,.15);
            }

        .product-image {
            height: 200px;
            object-fit: cover;
            width: 100%;
        }

        .product-price {
            color: #dc3545;
            font-size: 1.25rem;
            font-weight: bold;
        }

        /* Section Headers */
        .section-header {
            text-align: center;
            margin-bottom: 40px;
        }

            .section-header h2 {
                font-weight: bold;
                color: #333;
                position: relative;
                display: inline-block;
                padding-bottom: 10px;
            }

                .section-header h2::after {
                    content: '';
                    position: absolute;
                    bottom: 0;
                    left: 50%;
                    transform: translateX(-50%);
                    width: 60px;
                    height: 3px;
                    background: linear-gradient(135deg, var(--primary-color) 0%, var(--secondary-color) 100%);
                }

        /* Cards */
        .card {
            border: none;
            border-radius: 12px;
            box-shadow: 0 4px 6px rgba(0,0,0,.05);
        }

            .card:hover {
                box-shadow: 0 8px 16px rgba(0,0,0,.1);
            }

        /* Buttons */
        .btn-primary {
            background: linear-gradient(135deg, var(--primary-color) 0%, var(--secondary-color) 100%);
            border: none;
            padding: 10px 24px;
            border-radius: 50px;
            font-weight: 600;
            transition: all 0.3s ease;
        }

            .btn-primary:hover {
                transform: translateY(-2px);
                box-shadow: 0 4px 12px rgba(102, 126, 234, 0.4);
                color: white;
            }

        /* Forms */
        .form-control, .form-select {
            border-radius: 8px;
            padding: 12px 16px;
            border: 1px solid #dee2e6;
        }

            .form-control:focus {
                border-color: var(--primary-color);
                box-shadow: 0 0 0 0.25rem rgba(102, 126, 234, 0.25);
            }

        /* Footer */
        footer {
            background: #2d3748;
            color: white;
            padding: 40px 0 20px;
            margin-top: 60px;
        }

            footer a {
                color: #cbd5e0;
                text-decoration: none;
            }

                footer a:hover {
                    color: white;
                }

        /* Quantity input */
        .quantity-input {
            width: 70px;
            text-align: center;
        }

        /* Cart table */
        .cart-table th {
            background: var(--light-bg);
            font-weight: 600;
        }

        /* Order status badges */
        .status-new {
            background: #ffc107;
            color: #000;
            padding: 4px 12px;
            border-radius: 20px;
            font-size: 0.85rem;
        }

        .status-accepted {
            background: #17a2b8;
            color: white;
            padding: 4px 12px;
            border-radius: 20px;
            font-size: 0.85rem;
        }

        .status-shipping {
            background: #0dcaf0;
            color: white;
            padding: 4px 12px;
            border-radius: 20px;
            font-size: 0.85rem;
        }

        .status-completed {
            background: #198754;
            color: white;
            padding: 4px 12px;
            border-radius: 20px;
            font-size: 0.85rem;
        }

        .status-cancelled {
            background: #6c757d;
            color: white;
            padding: 4px 12px;
            border-radius: 20px;
            font-size: 0.85rem;
        }

        .status-rejected {
            background: #dc3545;
            color: white;
            padding: 4px 12px;
            border-radius: 20px;
            font-size: 0.85rem;
        }

        /* Hero Carousel - Enhanced */
        .hero-carousel {
            margin-bottom: 0;
        }

        .hero-carousel .carousel-item {
            height: 600px;
            position: relative;
        }

        .hero-slide {
            position: absolute;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background-size: cover !important;
            background-position: center !important;
            background-repeat: no-repeat !important;
        }

            /* Dark overlay for better text readability */
            .hero-slide::before {
                content: '';
                position: absolute;
                top: 0;
                left: 0;
                width: 100%;
                height: 100%;
                background: linear-gradient(135deg, rgba(102, 126, 234, 0.7) 0%, rgba(118, 75, 162, 0.7) 100%);
                z-index: 1;
            }

        .hero-slide .carousel-caption {
            position: absolute;
            left: 50%;
            top: 50%;
            transform: translate(-50%, -50%);
            text-align: center;
            z-index: 2;
            width: 90%;
            max-width: 800px;
            text-shadow: 2px 2px 8px rgba(0,0,0,0.5);
            animation: fadeInUp 1s ease-out;
        }

        @@keyframes fadeInUp {
            from {
                opacity: 0;
                transform: translate(-50%, -40%);
            }
            to {
                opacity: 1;
                transform: translate(-50%, -50%);
            }
        }

        .hero-slide .carousel-caption h2 {
            font-size: 3.5rem;
            font-weight: 800;
            margin-bottom: 1rem;
            text-shadow: 2px 2px 10px rgba(0,0,0,0.5);
        }

        .hero-slide .carousel-caption p.lead {
            font-size: 1.5rem;
            margin-bottom: 2rem;
            font-weight: 300;
        }

        .hero-slide .carousel-caption .btn {
            padding: 15px 40px;
            font-size: 1.1rem;
            font-weight: 600;
            border-radius: 50px;
            text-transform: uppercase;
            letter-spacing: 1px;
            transition: all 0.3s ease;
        }

            .hero-slide .carousel-caption .btn:hover {
                transform: translateY(-3px);
                box-shadow: 0 10px 30px rgba(0,0,0,0.3);
            }

        /* Carousel indicators styling */
        .carousel-indicators {
            bottom: 30px;
            z-index: 3;
        }

            .carousel-indicators [data-bs-target] {
                width: 12px;
                height: 12px;
                border-radius: 50%;
                background-color: rgba(255,255,255,0.5);
                border: none;
                margin: 0 5px;
            }

            .carousel-indicators .active {
                background-color: #fff;
                width: 30px;
                border-radius: 6px;
            }

        /* Carousel controls */
        .carousel-control-prev,
        .carousel-control-next {
            width: 5%;
            z-index: 3;
        }

        .carousel-control-prev-icon,
        .carousel-control-next-icon {
            width: 50px;
            height: 50px;
            background-color: rgba(255,255,255,0.2);
            border-radius: 50%;
            background-size: 60% 60%;
            transition: all 0.3s ease;
        }

        .carousel-control-prev:hover .carousel-control-prev-icon,
        .carousel-control-next:hover .carousel-control-next-icon {
            background-color: rgba(255,255,255,0.4);
            transform: scale(1.1);
        }

        /* Responsive adjustments */
        @@media (max-width: 768px) {
            .hero-carousel .carousel-item {
                height: 500px;
            }

            .hero-slide .carousel-caption h2 {
                font-size: 2rem;
            }

            .hero-slide .carousel-caption p.lead {
                font-size: 1rem;
            }
        }

        @@media (max-width: 576px) {
            .hero-carousel .carousel-item {
                height: 400px;
            }

            .hero-slide .carousel-caption h2 {
                font-size: 1.5rem;
            }

            .hero-slide .carousel-caption p.lead {
                font-size: 0.9rem;
            }

            .hero-slide .carousel-caption .btn {
                padding: 10px 25px;
                font-size: 0.9rem;
            }
        }

        /* Categories */
        .category-card {
            background: white;
            border-radius: 16px;
            padding: 30px 20px;
            text-align: center;
            box-shadow: 0 4px 15px rgba(0,0,0,0.08);
            transition: all 0.3s ease;
            cursor: pointer;
            height: 100%;
            text-decoration: none;
            color: inherit;
        }

            .category-card:hover {
                transform: translateY(-8px);
                box-shadow: 0 12px 30px rgba(102, 126, 234, 0.25);
                color: inherit;
            }

            .category-card .category-icon {
                width: 80px;
                height: 80px;
                margin: 0 auto 15px;
                background: linear-gradient(135deg, var(--primary-color) 0%, var(--secondary-color) 100%);
                border-radius: 50%;
                display: flex;
                align-items: center;
                justify-content: center;
                font-size: 2rem;
                color: white;
            }

            .category-card h5 {
                color: #333;
                font-weight: 600;
                margin-bottom: 0;
            }

        /* Product Badges */
        .product-badge {
            position: absolute;
            top: 10px;
            left: 10px;
            z-index: 10;
        }

            .product-badge .badge {
                padding: 6px 12px;
                font-size: 0.75rem;
                font-weight: 600;
                box-shadow: 0 2px 8px rgba(0,0,0,0.15);
            }

        /* Quick View Button */
        .quick-view-btn {
            position: absolute;
            bottom: 70px;
            left: 50%;
            transform: translateX(-50%) translateY(20px);
            opacity: 0;
            transition: all 0.3s ease;
        }

        .product-card:hover .quick-view-btn {
            transform: translateX(-50%) translateY(0);
            opacity: 1;
        }

        /* Image zoom effect */
        .product-image-wrapper {
            overflow: hidden;
            position: relative;
        }

        .product-image {
            transition: transform 0.5s ease;
        }

        .product-card:hover .product-image {
            transform: scale(1.08);
        }

        /* Empty state */
        .empty-state {
            text-align: center;
            padding: 60px 20px;
        }

            .empty-state i {
                font-size: 4rem;
                color: #dee2e6;
                margin-bottom: 20px;
            }

        /* Skeleton loading */
        .skeleton {
            background: linear-gradient(90deg, #f0f0f0 25%, #e0e0e0 50%, #f0f0f0 75%);
            background-size: 200% 100%;
            animation: skeleton-loading 1.5s infinite;
        }

        @@keyframes skeleton-loading {
            0% {
                background-position: 200% 0;
            }
            100% {
                background-position: -200% 0;
            }
        }

        /* Toast enhancements */
        .toast {
            min-width: 300px;
            box-shadow: 0 4px 16px rgba(0,0,0,0.2);
        }

        /* Sticky cart on mobile */
        @@media (max-width: 991.98px) {
            .cart-summary-sticky {
                position: static !important;
            }
        }

        /* Product details page */
        .product-gallery img {
            cursor: zoom-in;
        }

        /* Placeholder image */
        .img-placeholder {
            display: flex;
            align-items: center;
            justify-content: center;
            background: linear-gradient(135deg, #f5f7fa 0%, #c3cfe2 100%);
            color: #adb5bd;
            min-height: 200px;
        }

        .product-image[src$="nophoto.png"] {
            object-fit: cover;
            background: linear-gradient(135deg, #f5f7fa 0%, #c3cfe2 100%);
        }

        .product-attribute-table th {
            width: 150px;
            background: #f8f9fa;
        }

        /* Rating stars */
        .rating-stars {
            color: #ffc107;
        }

        /* Section spacing */
        .section-spacing {
            padding: 60px 0;
        }

        /* Card hover lift */
        .card-lift:hover {
            transform: translateY(-5px);
            transition: transform 0.3s ease;
        }
    </style>

    @RenderSection("Styles", required: false)
</head>
<body>
    <!-- Navigation -->
    <nav class="navbar navbar-expand-lg navbar-dark fixed-top">
        <div class="container">
            <a class="navbar-brand" href="/">
                <i class="bi bi-shop fs-3"></i> Thang Shop
            </a>
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div class="collapse navbar-collapse" id="navbarNav">
                <ul class="navbar-nav me-auto">
                    <li class="nav-item">
                        <a class="nav-link" asp-controller="Home" asp-action="Index">
                            <i class="bi bi-house-door me-1"></i>Trang chủ
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" asp-controller="Product" asp-action="Index">
                            <i class="bi bi-box-seam me-1"></i>Sản phẩm
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" asp-controller="Home" asp-action="About">
                            <i class="bi bi-info-circle me-1"></i>Giới thiệu
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" asp-controller="Home" asp-action="Contact">
                            <i class="bi bi-envelope me-1"></i>Liên hệ
                        </a>
                    </li>
                </ul>
                <ul class="navbar-nav">
                    @if (User.Identity?.IsAuthenticated == true)
                    {
                        <li class="nav-item dropdown">
                            <a class="nav-link dropdown-toggle" href="#" id="userDropdown" role="button" data-bs-toggle="dropdown">
                                <i class="bi bi-person-circle me-1"></i>
                                @User.Identity.Name
                            </a>
                            <ul class="dropdown-menu dropdown-menu-end">
                                <li><a class="dropdown-item" asp-controller="Account" asp-action="Profile"><i class="bi bi-person me-2"></i>Thông tin cá nhân</a></li>
                                <li><a class="dropdown-item" asp-controller="Order" asp-action="History"><i class="bi bi-clock-history me-2"></i>Lịch sử mua hàng</a></li>
                                <li><a class="dropdown-item" asp-controller="Order" asp-action="Tracking"><i class="bi bi-truck me-2"></i>Theo dõi đơn hàng</a></li>
                                <li><hr class="dropdown-divider"></li>
                                <li>
                                    <form method="post" asp-controller="Account" asp-action="Logout" class="d-inline">
                                        <button type="submit" class="dropdown-item text-danger">
                                            <i class="bi bi-box-arrow-right me-2"></i>Đăng xuất
                                        </button>
                                    </form>
                                </li>
                            </ul>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link position-relative" asp-controller="Cart" asp-action="Index" data-bs-toggle="modal" data-bs-target="#cartModal">
                                <i class="bi bi-cart3 fs-4" style="color: #fff; transition: all 0.3s;"></i>
                                <span class="position-absolute top-0 start-100 translate-middle badge rounded-pill bg-warning text-dark cart-badge" id="cartCount" style="font-weight: bold; box-shadow: 0 2px 8px rgba(0,0,0,0.3);">0</span>
                            </a>
                        </li>
                    }
                    else
                    {
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Account" asp-action="Login">
                                <i class="bi bi-box-arrow-in-right me-1"></i>Đăng nhập
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Account" asp-action="Register">
                                <i class="bi bi-person-plus me-1"></i>Đăng ký
                            </a>
                        </li>
                    }
                </ul>
            </div>
        </div>
    </nav>

    <!-- Cart Modal -->
    <div class="modal fade" id="cartModal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title"><i class="bi bi-cart3 me-2"></i>Giỏ hàng của bạn</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body" id="cartModalBody">
                    <!-- AJAX load cart here -->
                </div>
            </div>
        </div>
    </div>

    @* Hero Carousel Section - CHỈ HIỂN THỊ TRÊN TRANG CHỦ *@
    @if (currentController == "Home" && currentAction == "Index")
    {
        <section class="hero-carousel mb-0">
            <div id="mainCarousel" class="carousel slide" data-bs-ride="carousel" data-bs-interval="5000">
                <div class="carousel-indicators">
                    <button type="button" data-bs-target="#mainCarousel" data-bs-slide-to="0" class="active" aria-current="true" aria-label="Slide 1"></button>
                    <button type="button" data-bs-target="#mainCarousel" data-bs-slide-to="1" aria-label="Slide 2"></button>
                    <button type="button" data-bs-target="#mainCarousel" data-bs-slide-to="2" aria-label="Slide 3"></button>
                </div>
                <div class="carousel-inner">
                    <div class="carousel-item active">
                        <div class="hero-slide" style="background: linear-gradient(135deg, rgba(102, 126, 234, 0.75) 0%, rgba(118, 75, 162, 0.75) 100%), url('https://images.unsplash.com/photo-1607082350899-7e105aa886ae?ixlib=rb-4.0.3&auto=format&fit=crop&w=2000&q=80') center/cover; height: 600px; background-attachment: fixed;">
                            <div class="carousel-caption">
                                <h2 class="display-1 fw-bold mb-4 text-white">🎉 KHUYẾN MÃI LỚN</h2>
                                <p class="lead mb-4 fs-3 text-white">Giảm lên đến <strong class="text-warning">50%</strong> cho tất cả sản phẩm</p>
                                <a asp-controller="Product" asp-action="Index" class="btn btn-light btn-lg px-5 py-3">
                                    <i class="bi bi-bag me-2"></i> Mua ngay
                                </a>
                            </div>
                        </div>
                    </div>
                    <div class="carousel-item">
                        <div class="hero-slide" style="background: linear-gradient(135deg, rgba(39, 174, 96, 0.75) 0%, rgba(46, 204, 113, 0.75) 100%), url('https://images.unsplash.com/photo-1441986300917-64674bd600d8?ixlib=rb-4.0.3&auto=format&fit=crop&w=2000&q=80') center/cover; height: 600px; background-attachment: fixed;">
                            <div class="carousel-caption">
                                <h2 class="display-1 fw-bold mb-4 text-white">✨ SẢN PHẨM MỚI</h2>
                                <p class="lead mb-4 fs-3 text-white">Hàng ngày được cập nhật - Chất lượng đảm bảo</p>
                                <a asp-controller="Product" asp-action="Index" class="btn btn-light btn-lg px-5 py-3">
                                    <i class="bi bi-eye me-2"></i> Xem ngay
                                </a>
                            </div>
                        </div>
                    </div>
                    <div class="carousel-item">
                        <div class="hero-slide" style="background: linear-gradient(135deg, rgba(241, 196, 15, 0.85) 0%, rgba(243, 156, 18, 0.85) 100%), url('https://images.unsplash.com/photo-1586528116311-ad8dd3c8310c?ixlib=rb-4.0.3&auto=format&fit=crop&w=2000&q=80') center/cover; height: 600px; background-attachment: fixed;">
                            <div class="carousel-caption">
                                <h2 class="display-1 fw-bold mb-4 text-white">🚚 MIỄN PHÍ VẬN CHUYỂN</h2>
                                <p class="lead mb-4 fs-3 text-white">Cho đơn hàng từ <strong class="text-success">500.000đ</strong> trở lên</p>
                                <a asp-controller="Home" asp-action="About" class="btn btn-light btn-lg px-5 py-3">
                                    <i class="bi bi-info-circle me-2"></i> Tìm hiểu thêm
                                </a>
                            </div>
                        </div>
                    </div>
                </div>
                <button class="carousel-control-prev" type="button" data-bs-target="#mainCarousel" data-bs-slide="prev">
                    <span class="carousel-control-prev-icon" aria-hidden="true"></span>
                    <span class="visually-hidden">Previous</span>
                </button>
                <button class="carousel-control-next" type="button" data-bs-target="#mainCarousel" data-bs-slide="next">
                    <span class="carousel-control-next-icon" aria-hidden="true"></span>
                    <span class="visually-hidden">Next</span>
                </button>
            </div>
        </section>
    }

    <!-- Toast Notification -->
    <div class="toast-container position-fixed top-0 end-0 p-3" style="z-index: 1100;">
        <div id="liveToast" class="toast align-items-center text-white bg-success border-0" role="alert" aria-live="assertive" aria-atomic="true">
            <div class="d-flex">
                <div class="toast-body" id="toastBody"></div>
                <button type="button" class="btn-close btn-close-white me-2 m-auto" data-bs-dismiss="toast" aria-label="Close"></button>
            </div>
        </div>
    </div>

    <!-- Main Content Container (RenderBody) -->
    <main class="container" style="padding-top: 30px; min-height: calc(100vh - 450px);">
        @RenderBody()
    </main>

    <!-- Footer -->
    <footer>
        <div class="container">
            <div class="row">
                <div class="col-md-4 mb-4">
                    <h5><i class="bi bi-shop me-2"></i>ThangShop</h5>
                    <p>Hệ thống bán hàng trực tuyến uy tín, chất lượng với dịch vụ tốt nhất.</p>
                </div>
                <div class="col-md-4 mb-4">
                    <h5>Liên kết nhanh</h5>
                    <ul class="list-unstyled">
                       
                        <li><a href="/Product" class="text-light text-decoration-none"><i class="bi bi-chevron-right me-2"></i>Sản phẩm</a></li>
                        @if (User.Identity?.IsAuthenticated == true)
                        {
                            <li><a href="/Cart" class="text-light text-decoration-none"><i class="bi bi-chevron-right me-2"></i>Giỏ hàng</a></li>
                            <li><a href="/Account/Profile" class="text-light text-decoration-none"><i class="bi bi-chevron-right me-2"></i>Tài khoản</a></li>
                        }
                        else
                        {
                            <li><a href="/Account/Login" class="text-light text-decoration-none"><i class="bi bi-chevron-right me-2"></i>Đăng nhập</a></li>
                            <li><a href="/Account/Register" class="text-light text-decoration-none"><i class="bi bi-chevron-right me-2"></i>Đăng ký</a></li>
                        }
                        <li><a href="/Home/About" class="text-light text-decoration-none"><i class="bi bi-chevron-right me-2"></i>Giới thiệu</a></li>
                        <li><a href="/Home/Contact" class="text-light text-decoration-none"><i class="bi bi-chevron-right me-2"></i>Liên hệ</a></li>
                    </ul>
                </div>
                <div class="col-md-4 mb-4">
                    <h5>Thông tin liên hệ</h5>
                    <p>
                        <i class="bi bi-geo-alt me-2"></i>Địa chỉ: 123 Đường ABC, Quận XYZ<br>
                        <i class="bi bi-telephone me-2"></i>Hotline: 0909.999.999<br>
                        <i class="bi bi-envelope me-2"></i>Email: contact@Thangshop.vn
                    </p>
                </div>
            </div>
            <hr class="bg-light">
            <div class="text-center pb-3">
                <p class="mb-0">&copy; 2025 Thang. All rights reserved.</p>
            </div>
        </div>
    </footer>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://unpkg.com/aos@2.3.1/dist/aos.js"></script>
    <script>
        AOS.init({ duration: 800, easing: 'slide-in-out', once: true });

        // Load categories on homepage
        async function updateCartCount() {
            try {
                const response = await fetch('/Cart/Count');
                const data = await response.json();
                const badge = document.getElementById('cartCount');
                if (badge) {
                    const oldCount = parseInt(badge.textContent) || 0;
                    const newCount = data.count || 0;
                    badge.textContent = newCount;

                    // Thêm hiệu ứng bounce khi số lượng thay đổi (chỉ khi tăng)
                    if (newCount > oldCount) {
                        badge.classList.add('bounce');
                        setTimeout(() => badge.classList.remove('bounce'), 500);
                    }

                    // Ẩn badge nếu số lượng = 0
                    if (newCount === 0) {
                        badge.style.display = 'none';
                    } else {
                        badge.style.display = 'inline-block';
                    }
                }
            } catch (e) {
                console.error('Failed to update cart count:', e);
            }
        }
        document.addEventListener('DOMContentLoaded', updateCartCount);

        const cartModal = document.getElementById('cartModal');
        if (cartModal) {
            cartModal.addEventListener('show.bs.modal', async function() {
                try {
                    const response = await fetch('/Cart/GetCartModal');
                    const html = await response.text();
                    document.getElementById('cartModalBody').innerHTML = html;
                } catch (e) {
                    document.getElementById('cartModalBody').innerHTML = '<div class="alert alert-danger">Có lỗi xảy ra khi tải giỏ hàng</div>';
                }
            });
        }

        function showAlert(message, type = 'success') {
            const toastEl = document.getElementById('liveToast');
            const toastBody = document.getElementById('toastBody');

            // Set background color based on type
            const bgClass = type === 'success' ? 'bg-success' : 'bg-danger';
            toastEl.className = 'toast align-items-center text-white border-0';
            toastEl.classList.add(bgClass);

            toastBody.textContent = message;

            const toast = new bootstrap.Toast(toastEl, {
                delay: 5000,
                autohide: true
            });
            toast.show();
        }
    </script>

    @* Anti-Forgery Token for AJAX POST requests *@
    @Html.AntiForgeryToken()

    @RenderSection("Scripts", required: false)
</body>
</html>