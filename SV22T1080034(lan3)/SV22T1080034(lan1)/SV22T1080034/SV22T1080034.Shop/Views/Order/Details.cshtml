@using SV22T1080034.DomainModels.Sales
@model OrderViewInfo
@{
    ViewBag.Title = ViewBag.Title ?? $"Chi tiết đơn hàng #{Model.OrderID}";
    var details = ViewBag.OrderDetails as List<OrderDetailViewInfo> ?? new List<OrderDetailViewInfo>();
    var productPhotos = ViewBag.ProductPhotos as Dictionary<int, string> ?? new Dictionary<int, string>();
    // Tính tổng từ chi tiết đơn hàng (đảm bảo chính xác)
    var subtotal = details.Sum(d => d.SalePrice * d.Quantity);
}

@section Styles {
    <style>
        .timeline {
            position: relative;
            padding-left: 30px;
        }

            .timeline::before {
                content: '';
                position: absolute;
                left: 8px;
                top: 0;
                bottom: 0;
                width: 2px;
                background: #e9ecef;
            }

        .timeline-item {
            position: relative;
            margin-bottom: 1.5rem;
        }

            .timeline-item::before {
                content: '';
                position: absolute;
                left: -22px;
                top: 6px;
                width: 12px;
                height: 12px;
                border-radius: 50%;
                background: #667eea;
                border: 3px solid white;
                box-shadow: 0 0 0 3px #667eea;
            }

            .timeline-item.completed::before {
                background: #28a745;
                box-shadow: 0 0 0 3px #28a745;
            }

            .timeline-item.cancelled::before {
                background: #dc3545;
                box-shadow: 0 0 0 3px #dc3545;
            }

            .timeline-item .timeline-content {
                background: #f8f9fa;
                padding: 10px 15px;
                border-radius: 8px;
                border-left: 3px solid #667eea;
            }

                .timeline-item.completed .timeline-content {
                    border-left-color: #28a745;
                }

                .timeline-item.cancelled .timeline-content {
                    border-left-color: #dc3545;
                }

            .timeline-item .timeline-title {
                font-weight: 600;
                margin-bottom: 0.25rem;
                color: #333;
            }

            .timeline-item .timeline-time {
                font-size: 0.875rem;
                color: #6c757d;
            }
    </style>
}

<div class="container mt-4" style="padding-top: 80px;" data-aos="fade-up">
    <div class="row">
        <div class="col-lg-8">
            <div class="card shadow border-0 rounded-4 mb-4">
                <div class="card-header bg-primary text-white">
                    <h4 class="mb-0"><i class="bi bi-receipt me-2"></i>Chi tiết đơn hàng #@Model.OrderID</h4>
                </div>
                <div class="card-body">
                    <div class="row mb-4">
                        <div class="col-md-6">
                            <h6><i class="bi bi-geo-alt me-2"></i>Địa chỉ giao hàng</h6>
                            <p class="mb-1">@Model.DeliveryAddress</p>
                            <p class="mb-0 text-muted">@Model.DeliveryProvince</p>
                        </div>
                        <div class="col-md-6">
                            <h6><i class="bi bi-info-circle me-2"></i>Thông tin đơn hàng</h6>
                            <ul class="list-unstyled mb-0">
                                <li><strong>Ngày đặt:</strong> @Model.OrderTime.ToString("dd/MM/yyyy HH:mm")</li>
                                <li><strong>Trạng thái:</strong> @Html.Partial("_OrderStatusBadge", Model.Status)</li>
                                @if (Model.ShippedTime.HasValue)
                                {
                                    <li><strong>Ngày giao:</strong> @Model.ShippedTime?.ToString("dd/MM/yyyy HH:mm")</li>
                                }
                            </ul>
                        </div>
                    </div>

                    <!-- Order Timeline -->
                    <div class="mt-4 pt-3 border-top">
                        <h6 class="mb-3"><i class="bi bi-clock-history me-2"></i>Tiến trình đơn hàng</h6>
                        <div class="timeline">
                            <div class="timeline-item completed">
                                <div class="timeline-content">
                                    <div class="timeline-title">Đơn hàng đã được đặt</div>
                                    <div class="timeline-time">@Model.OrderTime.ToString("dd/MM/yyyy HH:mm")</div>
                                </div>
                            </div>
                            @if (Model.Status >= OrderStatusEnum.Accepted)
                            {
                                <div class="timeline-item completed">
                                    <div class="timeline-content">
                                        <div class="timeline-title">Đơn hàng đã được duyệt</div>
                                        <div class="timeline-time">@(Model.ShippedTime.HasValue ? Model.ShippedTime.Value.ToString("dd/MM/yyyy HH:mm") : "Chưa xác định")</div>
                                    </div>
                                </div>
                            }
                            @if (Model.Status >= OrderStatusEnum.Shipping)
                            {
                                <div class="timeline-item completed">
                                    <div class="timeline-content">
                                        <div class="timeline-title">Đang giao hàng</div>
                                        <div class="timeline-time">@(Model.ShippedTime.HasValue ? Model.ShippedTime.Value.ToString("dd/MM/yyyy HH:mm") : "Chưa xác định")</div>
                                    </div>
                                </div>
                            }
                            @if (Model.Status == OrderStatusEnum.Completed)
                            {
                                <div class="timeline-item completed">
                                    <div class="timeline-content">
                                        <div class="timeline-title">Đơn hàng đã hoàn tất</div>
                                        <div class="timeline-time">@(Model.ShippedTime.HasValue ? Model.ShippedTime.Value.ToString("dd/MM/yyyy HH:mm") : "Chưa xác định")</div>
                                    </div>
                                </div>
                            }
                            @if (Model.Status == OrderStatusEnum.Cancelled || Model.Status == OrderStatusEnum.Rejected)
                            {
                                <div class="timeline-item cancelled">
                                    <div class="timeline-content">
                                        <div class="timeline-title">
                                            @(Model.Status == OrderStatusEnum.Cancelled ? "Đơn hàng đã bị hủy" : "Đơn hàng bị từ chối")
                                        </div>
                                        <div class="timeline-time">@Model.OrderTime.ToString("dd/MM/yyyy HH:mm")</div>
                                    </div>
                                </div>
                            }
                        </div>
                    </div>
                </div>
            </div>

            <!-- Danh sách sản phẩm -->
            <div class="card shadow border-0 rounded-4">
                <div class="card-header">
                    <h5 class="mb-0"><i class="bi bi-box-seam me-2"></i>Sản phẩm đã đặt</h5>
                </div>
                <div class="card-body p-0">
                    <div class="table-responsive">
                        <table class="table table-hover mb-0">
                            <thead class="table-light">
                                <tr>
                                    <th class="ps-4">Sản phẩm</th>
                                    <th class="text-center">Đơn giá</th>
                                    <th class="text-center">SL</th>
                                    <th class="text-center">Thành tiền</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var item in details)
                                {
                                    <tr>
                                        <td class="ps-4">
                                            <div class="d-flex align-items-center">
                                                @{
                                                    var photo = productPhotos != null && productPhotos.ContainsKey(item.ProductID) ? productPhotos[item.ProductID] : "";
                                                    var imgSrc = string.IsNullOrEmpty(photo) ? "/images/products/nophoto.png" : $"/images/products/{photo}";
                                                }
                                                <img src="@imgSrc"
                                                     style="width: 60px; height: 60px; object-fit: cover;"
                                                     class="rounded me-3" alt="@item.ProductName"
                                                     onerror="this.onerror=null; this.src='/images/products/nophoto.png'">
                                                <div>
                                                    <h6 class="mb-1">@item.ProductName</h6>
                                                </div>
                                            </div>
                                        </td>
                                        <td class="align-middle text-center">
                                            @item.SalePrice.ToString("N0") ₫
                                        </td>
                                        <td class="align-middle text-center">@item.Quantity</td>
                                        <td class="align-middle text-center">
                                            <span class="fw-bold">@((item.SalePrice * item.Quantity).ToString("N0")) ₫</span>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-lg-4">
            <div class="card shadow border-0 rounded-4 sticky-top" style="top: 100px;">
                <div class="card-body p-4">
                    <h5 class="card-title mb-3"><i class="bi bi-calculator me-2"></i>Tổng đơn hàng</h5>

                    <div class="d-flex justify-content-between mb-2">
                        <span>Tạm tính:</span>
                        <span class="fw-bold">@subtotal.ToString("N0") ₫</span>
                    </div>
                    <div class="d-flex justify-content-between mb-2">
                        <span>Phí vận chuyển:</span>
                        <span class="text-success">Miễn phí</span>
                    </div>
                    <hr>
                    <div class="d-flex justify-content-between mb-4">
                        <span class="fs-5 fw-bold">Tổng cộng:</span>
                        <span class="fs-5 fw-bold text-danger">@subtotal.ToString("N0") ₫</span>
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-bold">Trạng thái đơn hàng:</label>
                        <div>
                            @Html.Partial("_OrderStatusBadge", Model.Status)
                        </div>
                    </div>

                    @if (Model.Status == OrderStatusEnum.New)
                    {
                        <form method="post" action="/Order/Cancel" onsubmit="return confirm('Hủy đơn hàng này?');">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="id" value="@Model.OrderID" />
                            <button type="submit" class="btn btn-outline-danger w-100">
                                <i class="bi bi-x-circle me-2"></i>Hủy đơn hàng
                            </button>
                        </form>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        // Hiển thị thông báo từ TempData (sau khi đặt hàng thành công)
        @if (TempData["SuccessMessage"] != null)
        {
            <text>
                document.addEventListener('DOMContentLoaded', function() {
                    showAlert(@Html.Raw(System.Text.Json.JsonSerializer.Serialize(TempData["SuccessMessage"])), 'success');
                });
            </text>
        }
    </script>
}
