@using SV22T1080034.DomainModels.Common
@using SV22T1080034.DomainModels.Sales
@model PagedResult<OrderViewInfo>

@{
    ViewBag.Title = ViewBag.Title ?? "Theo dõi đơn hàng";
}

@section Styles {
    <style>
        .order-table {
            border-radius: 12px;
            overflow: hidden;
        }

            .order-table thead th {
                font-weight: 600;
                text-transform: uppercase;
                font-size: 0.85rem;
                letter-spacing: 0.5px;
                background: linear-gradient(135deg, #667eea 0%, #764ba2 100%) !important;
                color: white !important;
                padding: 15px;
            }

            .order-table tbody tr {
                transition: all 0.3s ease;
            }

                .order-table tbody tr:hover {
                    background-color: #f8f9fa;
                    transform: translateX(4px);
                }

            .order-table tbody td {
                padding: 15px;
                vertical-align: middle;
            }

        .empty-state {
            text-align: center;
            padding: 80px 20px;
            background: #f8f9fa;
            border-radius: 20px;
        }

            .empty-state i {
                font-size: 5rem;
                color: #dee2e6;
                margin-bottom: 20px;
            }

        .btn-order-details {
            padding: 6px 16px;
            border-radius: 20px;
            font-weight: 500;
            transition: all 0.3s ease;
        }

            .btn-order-details:hover {
                transform: translateY(-2px);
                box-shadow: 0 4px 12px rgba(102, 126, 234, 0.3);
            }
    </style>
}

<div class="container mt-4" style="padding-top: 80px;" data-aos="fade-up">
    <h2 class="mb-4"><i class="bi bi-truck me-2"></i>Theo dõi đơn hàng</h2>

    @if (Model.DataItems.Any())
    {
        <div class="card shadow border-0 rounded-4 overflow-hidden">
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-hover mb-0 order-table">
                        <thead class="table-light">
                            <tr>
                                <th style="width: 10%;">Mã đơn hàng</th>
                                <th style="width: 20%;">Ngày đặt</th>
                                <th style="width: 15%;">Tổng tiền</th>
                                <th style="width: 15%;">Trạng thái</th>
                                <th style="width: 20%;" class="text-center">Thao tác</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var order in Model.DataItems)
                            {
                                <tr>
                                    <td class="align-middle">
                                        <strong class="text-primary">#@order.OrderID</strong>
                                    </td>
                                    <td class="align-middle">
                                        @order.OrderTime.ToString("dd/MM/yyyy HH:mm")
                                    </td>
                                    <td class="align-middle">
                                        <span class="text-danger fw-bold">@order.TotalPrice.ToString("N0") ₫</span>
                                    </td>
                                    <td class="align-middle">
                                        @Html.Partial("_OrderStatusBadge", order.Status)
                                    </td>
                                    <td class="align-middle text-center">
                                        <a href="/Order/Details/@order.OrderID" class="btn btn-sm btn-outline-primary btn-order-details">
                                            <i class="bi bi-eye me-1"></i>Chi tiết
                                        </a>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>

        <!-- Pagination (Smart) -->
        @if (Model.RowCount > Model.PageSize)
        {
            int totalPages = (int)Math.Ceiling((double)Model.RowCount / Model.PageSize);
            int currentPage = Model.Page;
            int maxPagesToShow = 7;

            <nav class="mt-4" aria-label="Page navigation">
                <ul class="pagination justify-content-center">

                    <!-- Previous Button -->
                    <li class="page-item @(currentPage == 1 ? "disabled" : "")">
                        <a class="page-link" href="?page=@(currentPage - 1)&pageSize=@Model.PageSize">
                            <i class="bi bi-chevron-left"></i>
                        </a>
                    </li>

                    @{
                        int startPage = 1;
                        int endPage = totalPages;

                        if (totalPages <= maxPagesToShow)
                        {
                            startPage = 1;
                            endPage = totalPages;
                        }
                        else
                        {
                            int halfMax = maxPagesToShow / 2;
                            startPage = Math.Max(1, currentPage - halfMax);
                            endPage = Math.Min(totalPages, startPage + maxPagesToShow - 1);

                            if (endPage - startPage + 1 < maxPagesToShow)
                            {
                                startPage = Math.Max(1, endPage - maxPagesToShow + 1);
                            }
                        }

                        // Always show first page
                        if (startPage > 1)
                        {
                            <li class="page-item"><a class="page-link" href="?page=1&pageSize=@Model.PageSize">1</a></li>
                        }

                        // Show ellipsis if needed
                        if (startPage > 2)
                        {
                            <li class="page-item disabled"><span class="page-link">...</span></li>
                        }

                        // Page numbers
                        for (int i = startPage; i <= endPage; i++)
                        {
                            <li class="page-item @(i == currentPage ? "active" : "")">
                                <a class="page-link" href="?page=@i&pageSize=@Model.PageSize">@i</a>
                            </li>
                        }

                        // Show ellipsis if needed
                        if (endPage < totalPages - 1)
                        {
                            <li class="page-item disabled"><span class="page-link">...</span></li>
                        }

                        // Always show last page
                        if (endPage < totalPages)
                        {
                            <li class="page-item"><a class="page-link" href="?page=@totalPages&pageSize=@Model.PageSize">@totalPages</a></li>
                        }
                    }

                    <!-- Next Button -->
                    <li class="page-item @(currentPage == totalPages ? "disabled" : "")">
                        <a class="page-link" href="?page=@(currentPage + 1)&pageSize=@Model.PageSize">
                            <i class="bi bi-chevron-right"></i>
                        </a>
                    </li>
                </ul>
            </nav>
        }
    }
    else
    {
        <div class="alert alert-info text-center py-5">
            <i class="bi bi-truck fs-1 mb-3 d-block"></i>
            <h4>Chưa có đơn hàng nào</h4>
            <p class="mb-0">Bạn chưa có đơn hàng nào để theo dõi.</p>
            <a href="/Product" class="btn btn-primary mt-3">
                <i class="bi bi-box-seam me-2"></i>Mua sắm ngay
            </a>
        </div>
    }
</div>
